{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NAI V5 Studio",
  "version": "0.4.8",
  "identifier": "local.nai.v5studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NAI V5 Studio",
        "width": 820,
        "height": 1180,
        "minWidth": 420,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPCACHE/nai-v5-images/**/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/danbooru.sqlite.gz",
      "resources/danbooru.version"
    ]
  }
}
